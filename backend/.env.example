# Database — leave unset to use the built-in in-memory dev DB (pg-mem)
#DATABASE_URL=postgresql://user:password@localhost:5432/isoko_academy
#SUPABASE_URL=
#SUPABASE_ANON_KEY=
#SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_SECRET=isoko-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Twilio (unset = dev mode: OTP 123456 works, code returned in response)
#TWILIO_ACCOUNT_SID=
#TWILIO_AUTH_TOKEN=
#TWILIO_PHONE_NUMBER=

# Claude AI (unset = offline rule-based coach)
#CLAUDE_API_KEY=
CLAUDE_MAX_CALLS_PER_DAY=20
CLAUDE_MAX_COST_PER_CALL=0.05

# Server
PORT=3100
NODE_ENV=development
FRONTEND_URL=http://localhost:8081
ADMIN_URL=http://localhost:3100
